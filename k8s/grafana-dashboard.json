{
  "dashboard": {
    "uid": "video-origin-sre",
    "title": "Video Origin — SRE Golden Signals",
    "timezone": "browser",
    "refresh": "10s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1, "type": "timeseries", "title": "Request rate (QPS) by status",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"video-origin\"}[2m]))",
          "legendFormat": "{{status}}"
        }]
      },
      {
        "id": 2, "type": "timeseries", "title": "Latency p95 / p99 (s)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"video-origin\"}[2m])))", "legendFormat": "p95" },
          { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"video-origin\"}[2m])))", "legendFormat": "p99" }
        ]
      },
      {
        "id": 3, "type": "timeseries", "title": "5xx error ratio",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
        "targets": [{
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"video-origin\",status=~\"5..\"}[2m])) / sum(rate(http_server_requests_seconds_count{job=\"video-origin\"}[2m]))",
          "legendFormat": "5xx ratio"
        }]
      },
      {
        "id": 4, "type": "timeseries", "title": "JVM heap used (bytes)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "fieldConfig": { "defaults": { "unit": "bytes" } },
        "targets": [{
          "expr": "sum by (pod) (jvm_memory_used_bytes{job=\"video-origin\", area=\"heap\"})",
          "legendFormat": "{{pod}}"
        }]
      },
      {
        "id": 5, "type": "timeseries", "title": "Container memory working set vs limit",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "fieldConfig": { "defaults": { "unit": "bytes" } },
        "targets": [
          { "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"default\", pod=~\"video-origin.*\", container=\"video-origin\"})", "legendFormat": "{{pod}}" },
          { "expr": "min(kube_pod_container_resource_limits{namespace=\"default\", resource=\"memory\", container=\"video-origin\"})", "legendFormat": "memory limit" }
        ]
      },
      {
        "id": 6, "type": "timeseries", "title": "Pod restarts (container)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"default\", pod=~\"video-origin.*\"})",
          "legendFormat": "{{pod}}"
        }]
      }
    ]
  },
  "folderUid": "",
  "overwrite": true
}
